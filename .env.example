# Copy this file to .env and fill in your own values.
# .env is gitignored on purpose - it's per-host config/secrets, not code.

# Display name shown in the server browser / connect screen. Safe to change
# any time, on any host - it does NOT affect which world loads.
SERVER_NAME=MyValheimServer

# The world's save-file name. THIS MUST STAY IDENTICAL across every host
# that hosts this world (including a friend's machine), or the server will
# generate a brand new empty world instead of loading your progress.
WORLD_NAME=Midgard

# Connect password. Valheim requires 5+ characters, and it can't be a
# substring of SERVER_NAME.
SERVER_PASS=MidgardPass1

# false = not listed in the public server browser (LAN/invite-only).
SERVER_PUBLIC=false

# Space-separated SteamID64 list. Overwrites config/adminlist.txt on boot.
# Admins can use the in-game console (F5) for things like removekey.
ADMINLIST_IDS=

# Loads BepInEx mods from config/bepinex/plugins/ (see README "Admin dev
# commands" for the Server Devcommands mod, which lets adminlist'd players
# use dev commands via the in-game console).
BEPINEX=false

# World modifiers / difficulty knobs, passed straight to the Valheim server
# binary. Restart the server (docker compose up -d) after changing this.
#
# -preset NAME              Normal | Casual | Easy | Hard | Hardcore | Immersive | Hammer
#                            Must come FIRST - a -preset after -modifier args
#                            silently overwrites them.
# -modifier combat VALUE       veryeasy | easy | hard | veryhard
# -modifier deathpenalty VALUE casual | veryeasy | easy | hard | hardcore
# -modifier resources VALUE    muchless | less | more | muchmore | most   (item/resource drop rate)
# -modifier raids VALUE        none | muchless | less | more | muchmore
# -modifier portals VALUE      casual | hard | veryhard
# -setkey KEY                  nobuildcost | playerevents | passivemobs | nomap
#
# Current defaults below, combat left untouched:
#   resources most      -> highest built-in drop-rate tier (3x - there's no
#                          native 4x; for an exact 4x you'd need a mod like
#                          ValheimPlus instead of this vanilla modifier)
#   portals casual       -> carry everything through portals, incl. ore/metal
#   deathpenalty casual  -> designed to mean no skill loss and no item drop
#                          on death; a few players report it still drops
#                          carried (non-equipped) items - worth confirming
#                          in-game before you rely on it
#   raids muchless        -> rarest non-disabled raid frequency (raids none
#                          turns them off completely)
#
# nobuildcost is temporarily removed (was: -setkey nobuildcost) - add it
# back to the line below if you want free building again.
SERVER_ARGS=-modifier resources most -modifier portals casual -modifier deathpenalty casual -modifier raids muchless

# Seconds between checks for game updates (auto-restarts the server to apply).
UPDATE_INTERVAL=900

# Automatic world backups made by the container itself, independent of the
# migration backup.sh script below.
BACKUPS_INTERVAL=3600
BACKUPS_DIRECTORY=/config/backups
BACKUPS_MAX_AGE=3

TZ=Europe/Bucharest
